# ─────────────────────────────────────────────────────────────────────────────
# ft_transcendence — Docker environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then initialize Docker secrets:
#   ./scripts/setup-docker.sh
#
# Production (images compilées) :
#   docker compose up --build
# Development (hot reload) :
#   docker compose -f docker-compose.dev.yml up --build
#
# Limites CPU/RAM (dev uniquement) : voir docker-compose.dev.yml (section x-*-limits).
# Budget total ~2 Go ; réduisez les valeurs si la VM plante encore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ft_user
POSTGRES_DB=ft_transcendence
# Host port only (container still uses 5432 internally).
# Default 5433 to avoid clashing with a local PostgreSQL on 5432.
POSTGRES_PORT=5433
# Password is stored in secrets/postgres_password (not here)

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
# Dev (docker-compose.dev.yml) : Vite
FRONTEND_PORT=5173
# Production (docker-compose.yml) : nginx en HTTPS ; HTTP redirige vers HTTPS
HTTPS_PORT=8443
HTTP_PORT=8080

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Production : URL publique unique (site + API sous /api + websockets).
# Certificat auto-signé généré au premier démarrage : accepter l'avertissement Chrome.
PUBLIC_URL=https://localhost:8443
# Dev uniquement (docker-compose.dev.yml)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# ── 42 OAuth ─────────────────────────────────────────────────────────────────
# Create your app at: https://profile.intra.42.fr/oauth/applications
CLIENT_ID=your-42-client-id
# Secret is stored in secrets/client_secret (not here)
# Dev : http://localhost:5000/auth/42/callback
# Production : ${PUBLIC_URL}/api/auth/42/callback (ex. https://localhost:8443/api/auth/42/callback)
# -> ajouter les deux dans les "Redirect URI" de l'app 42.
REDIRECT_URI=http://localhost:5000/auth/42/callback

# ── JWT expiration (secrets are in secrets/ directory) ───────────────────────
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1h
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d
JWT_PRE_AUTH_TOKEN_EXPIRATION_TIME=15m

# ── Seed (créé au démarrage Docker, mot de passe commun Test1234!) ──────────
# admin@ft.local (ADMIN) / alice@ft.local / bob@ft.local
RUN_SEED=true

# ── Local development (outside Docker) ───────────────────────────────────────
# When running backend/frontend locally without Docker, set DATABASE_URL in
# backend/.env instead:
# DATABASE_URL=postgresql://ft_user:YOUR_PASSWORD@localhost:5432/ft_transcendence?schema=public

# Sauvegardes PostgreSQL (service "backup") et page /status
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
# Au-delà, /status affiche les sauvegardes comme "trop anciennes"
BACKUP_MAX_AGE_HOURS=36

# ── Emails (RGPD : confirmations d'export / suppression) ─────────────────────
# Par défaut, les emails vont dans Mailpit (boîte de test) : http://localhost:8025
# Pour un vrai SMTP, changer SMTP_HOST/SMTP_PORT (et SMTP_USER/SMTP_PASSWORD si besoin).
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=42 Baby <no-reply@ft.local>
MAILPIT_UI_PORT=8025
