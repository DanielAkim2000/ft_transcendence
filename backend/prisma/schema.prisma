generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ONLINE
  OFFLINE
  IN_GAME
}

enum TableStatus {
  FREE
  BUSY
}

enum QueueGroupStatus {
  INVITING
  WAITING
  CALLED
  ON_TABLE
  DONE
  EXPIRED
  CANCELLED
}

enum MatchFormat {
  ONE_V_ONE
  TWO_V_TWO
}

enum MatchStatus {
  PENDING
  DECLINED
  ACCEPTED
  PENDING_VALIDATION
  COMPLETED
  DISPUTED
}

enum TournamentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TournamentTieStatus {
  PENDING
  READY
  IN_PROGRESS
  DONE
}

enum BadgeCode {
  FIRST_WIN
  TEN_WINS
  FIFTY_MATCHES
  WIN_STREAK_3
  TOURNAMENT_FINALIST
  TOURNAMENT_CHAMPION
  GIANT_SLAYER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Historique persistant des notifications personnelles (hors chat, qui a déjà
// son propre système de non-lus). Un événement temps réel qui concerne un
// utilisateur précis crée aussi une ligne ici ; `data` porte tout ce qu'il
// faut pour l'afficher sans requête supplémentaire (noms déjà résolus).
enum NotificationType {
  FRIEND_REQUEST
  MATCH_PROPOSED
  MATCH_ACCEPTED
  MATCH_DECLINED
  MATCH_SCORE_SUBMITTED
  MATCH_COMPLETED
  MATCH_DISPUTED
  QUEUE_INVITE
  QUEUE_INVITE_DECLINED
  QUEUE_GROUP_CLOSED
  QUEUE_CALLED
  QUEUE_EXPIRED
  TABLE_MATCH_STARTED
  TABLE_SCORE_REQUIRED
  TABLE_MATCH_ENDED
  TABLE_MATCH_CANCELLED
  TOURNAMENT_LAUNCHED
  TOURNAMENT_TABLE_RECLAIMED
  TOURNAMENT_TIE_STARTED
  TOURNAMENT_TIE_WON
  TOURNAMENT_ELIMINATED
  TOURNAMENT_COMPLETED
  BADGE_EARNED
}

enum ThemePreference {
  light
  dark
  system
}

enum LanguagePreference {
  en
  fr
  es
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  requester   User             @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

model User {
  id                         String             @id @default(cuid())
  login42                    String?            @unique
  email                      String             @unique
  displayname                String
  avatarUrl                  String?
  passwordHash               String?
  twoFactorEnabled           Boolean            @default(false)
  twoFactorSecret            String?
  twoFactorPendingSecret     String?
  isOnline                   Boolean            @default(false)
  status                     Status             @default(OFFLINE)
  role                       Role               @default(USER)
  theme                      ThemePreference    @default(light)
  language                   LanguagePreference @default(en)
  rating                     Int                @default(1000)
  matchesPlayed              Int                @default(0)
  wins                       Int                @default(0)
  xp                         Int                @default(0)
  currentWinStreak           Int                @default(0)
  bestWinStreak              Int                @default(0)
  badges                     UserBadge[]
  refreshTokens              RefreshToken[]
  friendshipsSent            Friendship[]       @relation("FriendshipsSent")
  friendshipsReceived        Friendship[]       @relation("FriendshipsReceived")
  conversationsAsA           Conversation[]     @relation("ConversationsAsA")
  conversationsAsB           Conversation[]     @relation("ConversationsAsB")
  messages                   Message[]
  blocksSent                 Block[]            @relation("BlocksSent")
  blocksReceived             Block[]            @relation("BlocksReceived")
  queueMemberships           QueueGroupMember[]
  releaseVotes               TableReleaseVote[]
  notifications              Notification[]
  matchesAsTeamAPlayer1      Match[]            @relation("MatchTeamAPlayer1")
  matchesAsTeamAPlayer2      Match[]            @relation("MatchTeamAPlayer2")
  matchesAsTeamBPlayer1      Match[]            @relation("MatchTeamBPlayer1")
  matchesAsTeamBPlayer2      Match[]            @relation("MatchTeamBPlayer2")
  matchesSubmitted           Match[]            @relation("MatchSubmittedBy")
  matchesValidated           Match[]            @relation("MatchValidatedBy")
  tournamentsCreated         Tournament[]       @relation("TournamentCreatedBy")
  tournamentEntriesAsPlayer1 TournamentEntry[]  @relation("TournamentEntryPlayer1")
  tournamentEntriesAsPlayer2 TournamentEntry[]  @relation("TournamentEntryPlayer2")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Conversation {
  id              String    @id @default(cuid())
  userAId         String
  userBId         String
  userA           User      @relation("ConversationsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User      @relation("ConversationsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  messages        Message[]
  userALastReadAt DateTime  @default(now())
  userBLastReadAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("BlocksSent", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Une table accueille au plus 2 groupes (côtés 0 et 1) ; le format (1v1 / 2v2)
// est fixé par le premier groupe et reste tant que la table ou sa file est active.
// Non représentable ici en DSL Prisma, ajoutés à la main dans la migration
// 20260928090000_queue_groups : index unique partiel (tableId, slot) WHERE
// status = 'ON_TABLE', et index unique partiel (userId) WHERE active sur
// QueueGroupMember (un utilisateur = au plus un groupe actif).
model Table {
  id                     String             @id @default(cuid())
  name                   String             @unique
  status                 TableStatus        @default(FREE)
  format                 MatchFormat?
  occupiedAt             DateTime?
  // Non-null quand 2 joueurs ont demandé la libération : le score est attendu.
  endRequestedAt         DateTime?
  queueGroups            QueueGroup[]
  releaseVotes           TableReleaseVote[]
  // Non-null tant qu'un tournoi utilise cette table pour une rencontre en cours :
  // bloque la file normale le temps que le tournoi la récupère.
  currentTournamentTieId String?            @unique
  currentTournamentTie   TournamentTie?     @relation(fields: [currentTournamentTieId], references: [id], onDelete: SetNull)
  matchLegs              Match[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

// Un groupe (1 joueur en 1v1, 2 en 2v2) présent sur une table : soit en file,
// soit sur la table (slot 0 ou 1) face à l'autre groupe.
model QueueGroup {
  id        String             @id @default(cuid())
  tableId   String
  table     Table              @relation(fields: [tableId], references: [id], onDelete: Cascade)
  format    MatchFormat
  status    QueueGroupStatus   @default(INVITING)
  slot      Int?
  members   QueueGroupMember[]
  joinedAt  DateTime           @default(now())
  calledAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tableId, status, joinedAt])
}

// `active` reflète "le groupe n'est pas terminé" (cf. index unique partiel) ;
// `accepted` vaut false pour le coéquipier tant qu'il n'a pas répondu à l'invitation.
model QueueGroupMember {
  id          String     @id @default(cuid())
  groupId     String
  group       QueueGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRequester Boolean    @default(false)
  accepted    Boolean    @default(false)
  active      Boolean    @default(true)

  @@unique([groupId, userId])
  @@index([userId])
}

// Vote "libérer la table" d'un joueur présent sur la table ; à 2 votes le match s'arrête.
model TableReleaseVote {
  id        String   @id @default(cuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tableId, userId])
}

// Défi 1v1 / 2v2 indépendant des tables : on propose, l'autre accepte
// (et choisit son coéquipier en 2v2), puis n'importe qui joue et soumet
// le score, un adversaire valide. L'Elo est appliqué à la validation.
model Match {
  id     String      @id @default(cuid())
  format MatchFormat
  status MatchStatus @default(PENDING)

  teamAPlayer1Id String
  teamAPlayer1   User    @relation("MatchTeamAPlayer1", fields: [teamAPlayer1Id], references: [id], onDelete: Cascade)
  teamAPlayer2Id String?
  teamAPlayer2   User?   @relation("MatchTeamAPlayer2", fields: [teamAPlayer2Id], references: [id], onDelete: Cascade)
  teamBPlayer1Id String
  teamBPlayer1   User    @relation("MatchTeamBPlayer1", fields: [teamBPlayer1Id], references: [id], onDelete: Cascade)
  teamBPlayer2Id String?
  teamBPlayer2   User?   @relation("MatchTeamBPlayer2", fields: [teamBPlayer2Id], references: [id], onDelete: Cascade)

  scoreA        Int?
  scoreB        Int?
  submittedById String?
  submittedBy   User?   @relation("MatchSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  validatedById String?
  validatedBy   User?   @relation("MatchValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  // Non-nuls uniquement pour une rencontre de tournoi (legNumber 1/2, 3 = belle en cas d'égalité aller-retour).
  tournamentTieId String?
  tournamentTie   TournamentTie? @relation(fields: [tournamentTieId], references: [id], onDelete: Cascade)
  legNumber       Int?
  tableId         String?
  table           Table?         @relation(fields: [tableId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  respondedAt         DateTime?
  submittedAt         DateTime?
  validationExpiresAt DateTime?

  @@index([teamAPlayer1Id])
  @@index([teamAPlayer2Id])
  @@index([teamBPlayer1Id])
  @@index([teamBPlayer2Id])
  @@index([tournamentTieId])
}

// Un tournoi : brouillon (l'admin ajoute des entrées) -> lancé (tirage au sort,
// moteur d'attribution des tables) -> terminé. Format et aller-retour choisis
// à la création. Les points par tour s'ajoutent au même rating (User.rating).
model Tournament {
  id          String            @id @default(cuid())
  name        String
  format      MatchFormat
  twoLegged   Boolean           @default(false)
  status      TournamentStatus  @default(DRAFT)
  totalRounds Int?
  createdById String
  createdBy   User              @relation("TournamentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  entries     TournamentEntry[]
  ties        TournamentTie[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status])
}

// Une place dans le tableau : 1 joueur (1v1) ou 2 (2v2, équipe fixe pour tout le tournoi).
model TournamentEntry {
  id              String          @id @default(cuid())
  tournamentId    String
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  seed            Int
  player1Id       String
  player1         User            @relation("TournamentEntryPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id       String?
  player2         User?           @relation("TournamentEntryPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
  eliminatedRound Int?
  tiesAsA         TournamentTie[] @relation("TieEntryA")
  tiesAsB         TournamentTie[] @relation("TieEntryB")
  tiesWon         TournamentTie[] @relation("TieWinner")
  createdAt       DateTime        @default(now())

  @@unique([tournamentId, seed])
}

// Une rencontre du tableau (round/slot) : ronde 1 = 1er tour, jusqu'à totalRounds = finale.
// Pré-créée "à blanc" (PENDING, sans entries) pour les tours futurs dès le lancement,
// puis remplie au fur et à mesure que les vainqueurs avancent.
model TournamentTie {
  id            String              @id @default(cuid())
  tournamentId  String
  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round         Int
  slot          Int
  entryAId      String?
  entryA        TournamentEntry?    @relation("TieEntryA", fields: [entryAId], references: [id], onDelete: SetNull)
  entryBId      String?
  entryB        TournamentEntry?    @relation("TieEntryB", fields: [entryBId], references: [id], onDelete: SetNull)
  status        TournamentTieStatus @default(PENDING)
  winnerEntryId String?
  winnerEntry   TournamentEntry?    @relation("TieWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  pointsAwarded Int?
  legs          Match[]
  table         Table?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tournamentId, round, slot])
  @@index([tournamentId, status])
}

// Un badge gagné par un utilisateur. Le catalogue (nom, description, icône)
// est statique côté code, cette table ne garde que "qui a débloqué quoi, quand".
model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     BadgeCode
  earnedAt DateTime  @default(now())

  @@unique([userId, code])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}
