# Le port HTTP ne sert qu'a rediriger vers HTTPS.
server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    # Docker peut changer l'IP d'un conteneur apres un redemarrage.
    # Ce resolver evite que nginx garde une ancienne adresse du backend.
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $backend_upstream http://backend:${BACKEND_PORT};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Socket.IO : le navigateur passe par /api/socket.io, puis le backend /socket.io.
    location /api/socket.io/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Pour l'API, nginx enleve /api avant de transmettre au backend.
    # Le chemin du cookie est aussi adapte pour le navigateur.
    location /api/ {
        client_max_body_size 5m;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path /auth /api/auth;
    }

    # Les routes du front restent gerees par React.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
