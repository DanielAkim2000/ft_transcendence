# Redirige le HTTP vers le HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    # Résolution DNS du backend à chaque requête (résolveur interne de Docker) :
    # avec un simple proxy_pass sur un nom, nginx figerait l'IP au démarrage et
    # renverrait des 502 dès que le conteneur backend est recréé ou redémarré.
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $backend_upstream http://backend:${BACKEND_PORT};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # WebSockets (socket.io) : /api/socket.io -> backend /socket.io
    location /api/socket.io/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # API REST : /api/* -> backend /* (le cookie de refresh garde son chemin /auth)
    location /api/ {
        client_max_body_size 5m;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path /auth /api/auth;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
